    {
      "name": "openid_connect",
      "item": [
        {
          "name": "logout",
          "item": [
            {
              "name": "RP-Initiated Logout",
              "id": "4838c6ea-f8cf-4780-8a0b-551cb0a5fe67",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/openid_connect/logout?client_id=<string>&post_logout_redirect_uri=<uri>&state=<string>",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "openid_connect",
                    "logout"
                  ],
                  "query": [
                    {
                      "description": "(Required) Registered relying party identifier.",
                      "key": "client_id",
                      "value": "<string>"
                    },
                    {
                      "description": "(Required) Pre-registered post-logout redirect URI.",
                      "key": "post_logout_redirect_uri",
                      "value": "<uri>"
                    },
                    {
                      "description": "Opaque value (minimum 22 characters) echoed back to `post_logout_redirect_uri`.",
                      "key": "state",
                      "value": "<string>"
                    }
                  ]
                },
                "description": "Ends the user's Login.gov session. After confirmation the browser is redirected to the\npre-registered `post_logout_redirect_uri` with the original `state` value."
              },
              "response": [
                {
                  "id": "613c9eca-5df6-49e7-8a74-ac7fa920edd2",
                  "name": "Redirect back to `post_logout_redirect_uri` after the user confirms logout.",
                  "originalRequest": {
                    "method": "GET",
                    "header": [],
                    "url": {
                      "raw": "{{baseUrl}}/openid_connect/logout?client_id=<string>&post_logout_redirect_uri=<uri>&state=<string>",
