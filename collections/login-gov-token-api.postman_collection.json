          "item": [
            {
              "name": "token",
              "item": [
                {
                  "name": "Exchange Authorization Code for Tokens",
                  "id": "dfaeb9e7-a0b2-4618-8260-b0b09b307f6e",
                  "protocolProfileBehavior": {
                    "disableBodyPruning": true
                  },
                  "request": {
                    "method": "POST",
                    "header": [
                      {
                        "key": "Content-Type",
                        "value": "application/x-www-form-urlencoded"
                      },
                      {
                        "key": "Accept",
                        "value": "application/json"
                      }
                    ],
                    "body": {
                      "mode": "urlencoded",
                      "urlencoded": [
                        {
                          "description": "(Required) ",
                          "key": "grant_type",
                          "value": "authorization_code"
                        },
                        {
                          "description": "(Required) Authorization code returned from `/openid_connect/authorize`.",
                          "key": "code",
                          "value": "<string>"
                        },
                        {
                          "description": "Required for private_key_jwt clients.",
                          "key": "client_assertion_type",
                          "value": "urn:ietf:params:oauth:client-assertion-type:jwt-bearer"
                        },
                        {
                          "description": "Signed JWT (RS256) where `iss` and `sub` are `client_id`, `aud` is the token endpoint, and `jti`, `iat`, `exp` are set. Minimum 2048-bit key.",
                          "key": "client_assertion",
                          "value": "<string>"
                        },
                        {
                          "description": "PKCE code verifier matching the original `code_challenge`. Used by native apps in lieu of `client_assertion`.",
                          "key": "code_verifier",
                          "value": "<string>"
                        }
                      ]
                    },
                    "url": {
                      "raw": "{{baseUrl}}/api/openid_connect/token",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "api",
                        "openid_connect",
                        "token"
                      ]
                    },
                    "description": "Exchanges the authorization code for an `access_token` and a signed `id_token`. Web apps\nauthenticate using `private_key_jwt`; native apps use PKCE with a `code_verifier`."
                  },
                  "response": [
