                  "id": "07764d9c-8c1d-467a-86fd-3c4d887457cb",
                  "protocolProfileBehavior": {
                    "disableBodyPruning": true
                  },
                  "request": {
                    "auth": {
                      "type": "bearer",
                      "bearer": [
                        {
                          "key": "token",
                          "value": "{{bearerToken}}",
                          "type": "string"
                        }
                      ]
                    },
                    "method": "GET",
                    "header": [
                      {
                        "key": "Accept",
                        "value": "application/json"
                      }
                    ],
                    "url": {
                      "raw": "{{baseUrl}}/api/openid_connect/userinfo",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "api",
                        "openid_connect",
                        "userinfo"
                      ]
                    },
                    "description": "Returns user attributes consented to during authorization. Requires a bearer `access_token`."
                  },
